# Copy to .env and fill with local values. Never commit .env.

# MySQL (docker service: dbdental)
DB_PORT=3306:3306
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
MYSQL_DATABASE=dentalmoovi

# JDBC (used by principal + order_service; host is the Docker service name when using compose)
JDBC_DRIVER=com.mysql.cj.jdbc.Driver
DB_URL=jdbc:mysql://dbdental:3306/dentalmoovi
DB_USERNAME=dental
DB_PW=change-me-app
DB_URL_TEST=jdbc:mysql://dbdental:3306/dentalmoovi_test

# Spring — bind address (0.0.0.0 inside containers)
SPRING_ADDRESS_SERVER=0.0.0.0
SPRING_PORT_SERVER=8080
SPRING_PORT_ORDER=8081
SPRING_PORT_NOTIFICATIONS=8082

# Published ports (host)
FRONT_PORT=4201:4201
NOTIFICATION_PORT=8082:8082

# Frontend / cookies / CORS (local dev)
DOMAIN_URL=http://localhost:4201
DOMAIN=localhost

# JWT (generate a long random secret for any shared environment)
JWT_SECRET=change-me-use-openssl-rand-base64-32
JWT_COOKIE=ACCESS_TOKEN
JWT_TIME=86400000

# Inter-service URLs (Docker network hostnames)
EMAIL_SERVICE=http://dentalnotifications:8082
ORDER_SERVICE=http://dentalorders:8081

# SMTP (notifications_service — optional for local; use Mailtrap or similar)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
EMAIL=notifications@example.com
MAIL_PW=change-me-smtp
MAIL_PW_2=change-me-smtp-alt
